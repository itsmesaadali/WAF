# Copy this file to .env, then run scripts/setup.ps1 to generate the random secrets.
# Never commit .env or paste its values anywhere public.

# "local" or "live". Shown on the dashboard so you always know which mode you are in.
WAF_ENV=local

# --- Database (Neon PostgreSQL) ---
# Pooled URL: used by the running WAF.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct URL: used by Prisma migrations and the database tests.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Website the WAF protects (the only setting to change when switching sites) ---
# Local test site: http://127.0.0.1:3000
# Hosted site:     https://your-domain.example
UPSTREAM_URL=http://127.0.0.1:3000

# --- Secrets (generated by scripts/setup.ps1) ---
# Sent from the WAF to the website so the website can refuse direct visitors.
WAF_SHARED_SECRET=
# Signs admin login tokens.
JWT_SECRET=
# Signs the trained ML model file so a tampered file is refused.
MODEL_SIGNING_KEY=

# --- First admin account (only used when no admin exists yet) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- WAF behaviour ---
WAF_HOST=127.0.0.1
WAF_PORT=8000
# Number of trusted proxies in front of the WAF. 0 on your PC, usually 1 on hosting.
# Too high lets attackers fake their IP; too low bans the hosting proxy instead of the attacker.
TRUST_PROXY_HOPS=0
# What to do if the inspection code itself crashes: "closed" blocks, "open" allows.
FAIL_MODE=closed
MAX_BODY_BYTES=2097152
LOG_RETENTION_DAYS=30
# Admin-only button that sends test attacks to the configured UPSTREAM_URL through the WAF.
SIMULATOR_ENABLED=true

# --- Protected test website (protected-site/) ---
SITE_HOST=127.0.0.1
SITE_PORT=3000
